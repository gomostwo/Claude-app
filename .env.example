# Anthropic Claude API key (required for AI analysis)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot token (required for Telegram notifications)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...

# JWT secret key — use a long random string
SECRET_KEY=change-me-to-a-long-random-string-minimum-32-chars

# Database (SQLite, stored in ./data/)
DATABASE_URL=sqlite:///./data/stocks.db

# App settings
DEBUG=false
# Analysis runs once daily after the US daily candle closes (22:00 UTC Mon-Fri).
# Override only if you understand the impact on yfinance daily-bar settlement.
EOD_SCAN_HOUR_UTC=22

# ─── Market Data Providers (all optional) ───────────────────────────
# yfinance works without any key. Add provider keys below to enrich
# data with multi-source cross-validation for AI analysis.
#
# Finnhub       — 60 req/min free  | https://finnhub.io/register
# Twelve Data   — 800 req/day free | https://twelvedata.com/pricing
# FMP           — 250 req/day free | https://site.financialmodelingprep.com/developer
# Alpha Vantage — 25 req/day free  | https://www.alphavantage.co/support/#api-key
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=

# ─── Commodity-specific data (free, official) ───────────────────────
# EIA  — US Energy Info Admin     | https://www.eia.gov/opendata/register.php
# FRED — St. Louis Fed (macro)    | https://fred.stlouisfed.org/docs/api/api_key.html
# CFTC COT — public CSV, no key required
EIA_API_KEY=
FRED_API_KEY=

# ─── Tiered AI router ───────────────────────────────────────────────
# Tier 1 (DeepSeek V3, ultra-cheap screener) needs a DeepSeek key.
# Sign up: https://platform.deepseek.com/api_keys
# Tier 2/3 use ANTHROPIC_API_KEY above (Claude Haiku 4.5 + Sonnet 4.6).
DEEPSEEK_API_KEY=

# ─── Broker: Webull OpenAPI (NOT YET WIRED) ─────────────────────────
# Apply at: https://developer.webull.com/apis/docs/
# Setting these does NOT enable live trading on its own — you also need
# LIVE_TRADING_ENABLED=true AND a separate PR to wire the API calls.
# All four conditions must hold or order placement raises.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
LIVE_TRADING_ENABLED=false
